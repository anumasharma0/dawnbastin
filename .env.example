# ─── Dawbastion Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and customize

# Base URL of the sandbox host controller (host/app.py in the localrun repo,
# ../host relative to this frontend). All scanning now happens there — see
# ../API_DOCS.md for the full API reference.
# Default: http://127.0.0.1:8000
SANDBOX_API_URL=http://127.0.0.1:8000
